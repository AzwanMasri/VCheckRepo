<Page x:Class="VCheckViewer_Others.Views.Pages.Results.ResultPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:VCheckViewer_Others.Views.Pages.Results"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:userControls="clr-namespace:VCheckViewer_Others.UserControls"
      xmlns:Converter="clr-namespace:VCheckViewer_Others.Converter"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="ResultPage">

    <Page.Resources>
        <Style x:Key="DataGridVerticalText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Noto Sans" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Themes_GridResultFontColor}" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="DataGridVerticalTextCenterAligned" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="FontFamily" Value="Noto Sans" />
            <Setter Property="TextBlock.TextWrapping" Value="Wrap"/>
        </Style>
        
        <!--// TextBox //-->
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource Themes_SearchFieldBackground}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource Themes_SearchFieldFontColor}" />
            <Setter Property="Padding" Value="5, 2, 0, 0" />
        </Style>
        
        <!-- DataGridColumnHeader style -->
        <Style x:Key="ColumnHeaderStyle1"
               TargetType="DataGridColumnHeader">

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border BorderBrush="White"
                            Background="Transparent"
                            BorderThickness="0">

                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource Themes_GridHeaderFontColor}" 
                                       HorizontalAlignment="Left"
                                       FontWeight="Bold" 
                                       TextWrapping="Wrap"
                                       FontSize="13"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="columnHeaderStyleCenterAlign" TargetType="DataGridColumnHeader">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type DataGridColumnHeader}">
                        <Border BorderBrush="White"
                            Background="Transparent"
                            BorderThickness="0">

                            <TextBlock Text="{TemplateBinding Content}"
                                       Foreground="{DynamicResource Themes_GridHeaderFontColor}" 
                                       HorizontalAlignment="Center"
                                       FontWeight="Bold" 
                                       FontSize="13"/>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Converter:DateFormatConverter x:Key="DateFormatConverter"/>
    </Page.Resources>

    <Grid Margin="0, 10, 0, 10" MouseDown="CloseCalenderPopup" KeyDown="KeywordSearchBar_KeyDown">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="4*" />
            <ColumnDefinition Width="3*" />
            <ColumnDefinition Width="3*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.5*" />
            <RowDefinition Height="7*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border BorderBrush="Black" BorderThickness="0" Grid.Column="0" Grid.ColumnSpan="6" Grid.Row="0">
            <Grid Margin="20, 5, 0, 5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="15*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border BorderBrush="Black" BorderThickness="0" Grid.Column="0" Grid.Row="0" CornerRadius="7" Background="Transparent">
                    <Grid Margin="5, 2, 5, 2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="5*" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border BorderBrush="Black" BorderThickness="0" Grid.Column="0">
                            <Border BorderBrush="{DynamicResource Themes_SearchFieldBackground}" BorderThickness="1" Background="{DynamicResource Themes_SearchFieldBackground}" CornerRadius="7" Margin="10, 5, 5, 5">
                                <Grid>
                                    <Image Source="{DynamicResource Themes_SearchIcon}" Width="24" HorizontalAlignment="Left" Margin="5, 2, 0, 0" />

                                    <TextBox x:Name="KeywordSearchBar" BorderThickness="0" Margin="30,0,10,0" VerticalAlignment="Center" Style="{StaticResource TextBoxStyle}" KeyDown="KeywordSearchBar_KeyDown"/>
                                    <TextBlock IsHitTestVisible="False" Text="{Binding Path=Results_Label_Searchbar, Source={StaticResource Resources}}" 
                                               VerticalAlignment="Center" HorizontalAlignment="Left" Margin="40,0,10,0" Foreground="DarkGray"
                                               FontFamily="Noto Sans" FontSize="12" Background="{DynamicResource Themes_SearchFieldBackground}">
                                        <TextBlock.Style>
                                            <Style TargetType="{x:Type TextBlock}">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Text, ElementName=KeywordSearchBar}" Value="">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>
                        </Border>
                        <Grid Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            
                            <Border BorderBrush="Black" BorderThickness="0" Grid.Column="0" Background="Transparent">
                                <Border Background="{DynamicResource Themes_SearchFieldBackground}" CornerRadius="7" Margin="5, 5, 5, 5" BorderThickness="1" BorderBrush="{DynamicResource Themes_SearchFieldBackground}">
                                    <Grid>
                                        <Image Source="{DynamicResource Themes_CalendarIcon}" Width="24" HorizontalAlignment="Left" Margin="5,2,0,0" />

                                        <userControls:DateRangePicker x:Name="RangeDateStart" BorderThickness="0" Margin="30,0,10,0" VerticalAlignment="Center"
                                                    FontFamily="Noto Sans" FontSize="12" LostFocus="CloseCalender"/>
                                    </Grid>
                                </Border>
                            </Border>

                            <TextBlock Text=" - " FontWeight="Bold" Grid.Column="1" VerticalAlignment="Center"/>

                            <Border BorderBrush="Black" BorderThickness="0" Grid.Column="2" Background="Transparent">
                                <Border Background="{DynamicResource Themes_SearchFieldBackground}" CornerRadius="7" Margin="5, 5, 5, 5" BorderThickness="1" BorderBrush="{DynamicResource Themes_SearchFieldBackground}">
                                    <Grid>
                                        <Image Source="{DynamicResource Themes_CalendarIcon}" Width="24" HorizontalAlignment="Left" Margin="5,2,0,0" />

                                        <userControls:DateRangePicker x:Name="RangeDateEnd" BorderThickness="0" Margin="30,0,10,0" VerticalAlignment="Center"
                                                    FontFamily="Noto Sans" FontSize="12" LostFocus="CloseCalender"/>
                                    </Grid>
                                </Border>
                            </Border>
                        </Grid>
                        <Border BorderBrush="Black" BorderThickness="0" Grid.Column="2">
                            <Border CornerRadius="7" Margin="5, 5, 5, 5" BorderThickness="1" BorderBrush="{DynamicResource Themes_SearchFieldBackground}" Background="{DynamicResource Themes_SearchFieldBackground}">
                                <Grid>
                                    <Label Content="{Binding Path=Results_Label_SortBy, Source={StaticResource Resources}}" 
                                           FontFamily="Noto Sans" Foreground="{DynamicResource Themes_SearchFieldFontColor}" FontSize="12" VerticalContentAlignment="Center" 
                                           Margin="5, 5, 0, 0" />

                                    <ComboBox x:Name="cboSort" Background="Transparent" BorderThickness="0" Margin="60, 0, 5, 0"
                                          ItemsSource="{Binding cbSort}" SelectedItem="{Binding SelectedcbSort}" Foreground="{DynamicResource Themes_SearchFieldFontColor}"/>
                                </Grid>
                            </Border>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="0" Grid.Column="3">
                            <Border CornerRadius="7" Margin="5" BorderThickness="0" BorderBrush="Black" Background="{DynamicResource Themes_ButtonColor}">
                                <Button Name="btnFilter" Content="{Binding Path=General_Label_Searchbar, Source={StaticResource Resources}}" 
                                        Width="120" Foreground="White" VerticalAlignment="Stretch" HorizontalAlignment="Center" 
                                        BorderThickness="0" Background="Transparent" 
                                        Style="{DynamicResource RoundButton}"
                                        Click="btnFilter_Click">
                                </Button>
                            </Border>
                        </Border>
                        <Border BorderBrush="Black" BorderThickness="0" Grid.Column="4">
                            <Border CornerRadius="7" Margin="5" BorderThickness="0" BorderBrush="Black" Background="{DynamicResource Themes_ButtonColor}">
                                <Button Name="btnRefresh" Content="{Binding Path=Maintenance_Label_Refresh, Source={StaticResource Resources}}" 
                                        Width="120" Foreground="White" VerticalAlignment="Stretch" HorizontalAlignment="Center" 
                                        BorderThickness="0" Background="Transparent" 
                                        Style="{DynamicResource RoundButton}"
                                        Click="btnRefresh_Click">
                                </Button>
                            </Border>
                        </Border>
                    </Grid>
                </Border>
                <Border BorderBrush="Black" BorderThickness="0" Grid.Column="1" Grid.Row="0" HorizontalAlignment="Right">
                    <Button Name="btnDownload" BorderBrush="Black" BorderThickness="0" Background="Transparent" Click="btnDownload_Click">
                        <Image Source="{DynamicResource Themes_GridDownloadIcon}" Width="20" Height="20" />

                    </Button>
                </Border>
                <Border BorderBrush="Black" BorderThickness="0" Grid.Column="2" Grid.Row="0" HorizontalAlignment="Center">
                    <Button Name="btnPrint" Margin="1, 0, 5, 0" BorderThickness="0" BorderBrush="Black" Background="Transparent" Click="btnPrint_Click">
                        <Image Source="{DynamicResource Themes_GridPrintIcon}" Width="20" Height="20" />
                    </Button>
                </Border>
            </Grid>
        </Border>
        <TextBlock Name="txtTotalCount" Text="0" Visibility="Collapsed" />
        <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Margin="15, 10, 10, 5">
            <DataGrid Name="dgResult" BorderThickness="0" AutoGenerateColumns="False" GridLinesVisibility="Horizontal" Background="Transparent"
                RowHeaderWidth="0" ColumnHeaderStyle="{DynamicResource ColumnHeaderStyle1}" HorizontalGridLinesBrush="{DynamicResource Themes_GridRowLinesColor}" CanUserAddRows="False" CellEditEnding="dgResult_CellEditEnding" PreparingCellForEdit="dgResult_PreparingCellForEdit" MouseRightButtonDown="dgResult_MouseRightButtonDown" MouseLeftButtonDown="dgResult_MouseLeftButtonDown" ContextMenuService.IsEnabled="False">

                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource Themes_HighlightColor}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>

                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Name="menuEditPatientName" Tag="{Binding ID}" Header="{Binding Path=Results_Label_EditPatientName, Source={StaticResource Resources}}" Click="updateNameButton_Click"/>
                        <MenuItem Name="menuEditDoctorName" Tag="{Binding ID}" Header="Edit Doctor Name" Click="updateNameButton_Click"/>
                        <MenuItem Name="menuView" Header="{Binding Path=Results_Label_View, Source={StaticResource Resources}}" Click="menuView_Click"/>
                        <MenuItem Name="menuDownload" Header="{Binding Path=Results_Label_Download, Source={StaticResource Resources}}" Click="menuDownload_Click" />
                        <MenuItem Name="menuPrint" Header="{Binding Path=Results_Label_Print, Source={StaticResource Resources}}" Click="menuPrint_Click" />
                        <MenuItem Name="menuDelete" Header="{Binding Path=Device_Label_Button_Delete, Source={StaticResource Resources}}" Click="menuDelete_Click" />
                        <MenuItem Name="menuTransfer" Tag="{Binding ID}" Header="{Binding Path=Results_Label_SendToPMS, Source={StaticResource Resources}}" Click="menuTransfer_Click"/>
                    </ContextMenu>
                </DataGrid.ContextMenu>
                
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{Binding Path=Results_Label_No, Source={StaticResource Resources}}" Binding="{Binding RowNo}" Width="35" ElementStyle="{StaticResource DataGridVerticalText}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{Binding Path=Results_Label_PatientName, Source={StaticResource Resources}}" Binding="{Binding PatientName}" Width="*" ElementStyle="{StaticResource DataGridVerticalText}" IsReadOnly="False" />
                    <DataGridTextColumn Header="{Binding Path=Results_Label_OperatorID, Source={StaticResource Resources}}" Binding="{Binding OperatorID}" Width="*" ElementStyle="{StaticResource DataGridVerticalText}" IsReadOnly="True" />
                    <DataGridTextColumn Header="{Binding Path=Results_Label_PatientID, Source={StaticResource Resources}}" Binding="{Binding PatientID}" Width="*" ElementStyle="{StaticResource DataGridVerticalText}" IsReadOnly="True" />
                    <DataGridTextColumn Header="{Binding Path=Results_Label_TestResultType, Source={StaticResource Resources}}" Binding="{Binding TestResultType}" Width="*" ElementStyle="{StaticResource DataGridVerticalText}" IsReadOnly="True" />
                    <DataGridTemplateColumn Header="{Binding Path=Results_Label_Result, Source={StaticResource Resources}}" Width="*" IsReadOnly="True">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border CornerRadius="4" Margin="0, 5, 15, 5" Background="Transparent">
                                    <TextBlock Text="{Binding TestResultStatus}" FontSize="11" FontWeight="Bold" 
                                               Foreground="{Binding statusFontColor}" VerticalAlignment="Center" 
                                               HorizontalAlignment="Left" TextWrapping="WrapWithOverflow" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="{Binding Path=Results_Label_Time, Source={StaticResource Resources}}" Binding="{Binding TestResultDateTime, Converter={StaticResource DateFormatConverter}}" Width="*" ElementStyle="{StaticResource DataGridVerticalText}" IsReadOnly="True"/>
                    <DataGridTextColumn Header="{Binding Path=Results_Label_Doctor, Source={StaticResource Resources}}" Binding="{Binding InchargePerson}" Width="*" ElementStyle="{StaticResource DataGridVerticalText}" IsReadOnly="False"/>
                    <DataGridTextColumn Header="{Binding Path=Results_Label_DeviceSerialNo, Source={StaticResource Resources}}" Binding="{Binding DeviceSerialNo}" Width="*" ElementStyle="{StaticResource DataGridVerticalText}" IsReadOnly="True" />
                    <!--<DataGridTemplateColumn Width="0.3*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid HorizontalAlignment="Right">
                                    <Menu>
                                        <MenuItem>
                                            <MenuItem.Icon>
                                                <Image Source="{DynamicResource Themes_GirdUserMoreIcon}" Width="12"/>
                                            </MenuItem.Icon>
                                            <MenuItem Name="menuEditPatientName" Tag="{Binding ID}" Header="{Binding Path=Results_Label_EditPatientName, Source={StaticResource Resources}}" Click="updateNameButton_Click"/>
                                            <MenuItem Name="menuView" Header="{Binding Path=Results_Label_View, Source={StaticResource Resources}}" Click="menuView_Click"/>
                                            <MenuItem Name="menuDownload" Header="{Binding Path=Results_Label_Download, Source={StaticResource Resources}}" Click="menuDownload_Click" />
                                            <MenuItem Name="menuPrint" Header="{Binding Path=Results_Label_Print, Source={StaticResource Resources}}" Click="menuPrint_Click" />

                                            --><!-- POC Testing --><!--
                                            <MenuItem Name="menuTransfer" Tag="{Binding ID}" Header="{Binding Path=Results_Label_SendToPMS, Source={StaticResource Resources}}" Click="menuTransfer_Click" Visibility="{Binding PMSFunction}"/>
                                        </MenuItem>
                                    </Menu>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>-->
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding Path=General_Message_NoData, Source={StaticResource Resources}}" TextAlignment="Center" Margin="0,50,0,0" Visibility="{Binding Items.IsEmpty, Converter={StaticResource BooleanToVisibilityConverter}, ElementName=dgResult}" Foreground="{DynamicResource Themes_FontColor}"/>
        </Grid>

        <!-- // Pagination Control // -->
        <userControls:PagingControl x:Name="pagination" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6">
        </userControls:PagingControl>
    </Grid>
</Page>

