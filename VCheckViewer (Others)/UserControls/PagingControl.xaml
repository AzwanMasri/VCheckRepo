<UserControl x:Class="VCheckViewer_Others.UserControls.PagingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:VCheckViewer_Others.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <StackPanel x:Name="paginationPanel" Orientation="Horizontal" HorizontalAlignment="Right">
            <!--<Button Name="btnPrev" Content="{Binding Path=General_Label_Prev, Source={StaticResource Resources}}" Tag="Prev" BorderThickness="0" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource Themes_PaginationButtonColor}" Click="btnPrev_Click" Visibility="Hidden">
            </Button>-->
            <Button Name="btnPrev" Tag="Prev" Background="Transparent" BorderThickness="0" Click="btnPrev_Click" Visibility="Hidden">
                <Image Source="{DynamicResource Prev_Icon}" Width="20"/>
            </Button>
            <StackPanel x:Name="numberingSection" Orientation="Horizontal">
                
            </StackPanel>
            <!--<Button Name="btnNext" Content="{Binding Path=General_Label_Next, Source={StaticResource Resources}}" Tag="Next" BorderThickness="0" FontWeight="Bold" Background="Transparent" Foreground="{DynamicResource Themes_PaginationButtonColor}" Click="btnNext_Click" Visibility="Hidden">
            </Button>-->
            <Button Name="btnNext" Tag="Next" Background="Transparent" BorderThickness="0" Click="btnNext_Click" Visibility="Hidden">
                <Image Source="{DynamicResource Next_Icon}" Width="20"/>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
